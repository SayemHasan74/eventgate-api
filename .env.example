# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Testing - only for the dedicated integration-test database
TEST_DATABASE_URL=postgresql://eventgate:eventgate@localhost:5433/eventgate_test?schema=public

# Infrastructure - configured in Part 2
DATABASE_URL=postgresql://eventgate:eventgate@localhost:5432/eventgate?schema=public
REDIS_URL=redis://localhost:6379

# Authentication - configured in Parts 5 and 6
JWT_ACCESS_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-this-with-a-different-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
FRONTEND_URL=http://localhost:3000
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_RATE_LIMIT_MAX=10
DEMO_ATTENDEE_EMAIL=demo-attendee@example.test
DEMO_ATTENDEE_PASSWORD=replace-with-a-unique-demo-password
DEMO_ORGANIZER_EMAIL=demo-organizer@example.test
DEMO_ORGANIZER_PASSWORD=replace-with-a-unique-demo-password

# Development seed data - required only for `npm run db:seed`
SEED_ADMIN_EMAIL=admin@eventgate.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ORGANIZER_EMAIL=organizer@eventgate.local
SEED_ORGANIZER_PASSWORD=replace-with-a-strong-organizer-password
SEED_ATTENDEE_EMAIL=attendee@eventgate.local
SEED_ATTENDEE_PASSWORD=replace-with-a-strong-attendee-password

# SSLCommerz - configured in Parts 13 through 16
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:4000/api/v1/payments/sslcommerz/success
SSLCOMMERZ_FAIL_URL=http://localhost:4000/api/v1/payments/sslcommerz/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:4000/api/v1/payments/sslcommerz/cancel
SSLCOMMERZ_IPN_URL=http://localhost:4000/api/v1/payments/sslcommerz/ipn
# Separate demo merchant from the real/live merchant. Demo checkouts always use SSLCommerz sandbox.
DEMO_SSLCOMMERZ_STORE_ID=your-demo-sandbox-store-id
DEMO_SSLCOMMERZ_STORE_PASSWORD=your-demo-sandbox-store-password
